# ==============================================================================
# FITFLOW GYM MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit your actual .env file or credentials to source control.

# ── POSTGRESQL DATABASE CONFIGURATION ─────────────────────────────────────────
POSTGRES_DB=fitflow
POSTGRES_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fitflow
SPRING_DATASOURCE_USERNAME=postgres

# ── JWT SECURITY CONFIGURATION ────────────────────────────────────────────────
# 256-bit (64 hex characters) secret key for HMAC-SHA256 token signing
JWT_SECRET=your_64_character_hex_jwt_secret_here_replace_in_production
JWT_EXPIRATION_MS=86400000

# ── ADMINISTRATOR ACCOUNT CONFIGURATION ─────────────────────────────────────────
# Initial admin credentials seeded securely on first startup
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@fitflow.com
ADMIN_INITIAL_PASSWORD=YourStrongInitialAdminPassword123!

# ── DEMONSTRATION USERS SEEDING ────────────────────────────────────────────────
# Set to true in development/testing to seed 5 sample users with active/expiring/expired subscriptions
# Set to false in production to disable demonstration records
DEMO_SEED_ENABLED=true

# ── REAL SMTP / GMAIL EMAIL DELIVERY CONFIGURATION ─────────────────────────────
# Supported providers: Gmail SMTP, SendGrid, Amazon SES, Mailgun, Outlook.
# For Gmail SMTP:
# 1. Enable 2-Step Verification in Google Account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Put the 16-character App Password into MAIL_PASSWORD / SMTP_PASSWORD below (no spaces).
# 4. Set SMTP_ENABLED=true to activate live delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_or_smtp_address@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=FitFlow Gym
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_or_smtp_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_NAME=FitFlow Gym
SMTP_ENABLED=false

# ── DEADLINE NOTIFICATION RECIPIENT LIST ───────────────────────────────────────
# Designated Gmail recipient addresses for subscription deadline alerts & reminders
DEADLINE_NOTIFICATION_EMAILS=lakalkakaakaaa@gmail.com,appu12813@gmail.com,darshankm703@gmail.com
SUBSCRIPTION_REMINDER_DAYS=7

# ── OPTIONAL SMS NOTIFICATION CONFIGURATION (e.g. TWILIO) ──────────────────────
# SMS is separate from Gmail email delivery. Leave SMS_ENABLED=false if no provider credentials.
SMS_ENABLED=false
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── APPLICATION PORTS ──────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8080
